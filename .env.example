# Library Management System — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env with real secrets (PITFALLS C4, Threat T-01-01).

# PostgreSQL credentials
POSTGRES_USER=library_user
POSTGRES_PASSWORD=changeme_set_a_strong_password
POSTGRES_DB=library_db

# SQLAlchemy async connection URL (matches POSTGRES_* above)
DATABASE_URL=postgresql+asyncpg://library_user:changeme_set_a_strong_password@db:5432/library_db

# CORS — comma-separated list of allowed frontend origins.
# Include http://localhost:5173 for Vite dev server (D-07).
# Never use '*' here — see STACK.md CORS gotcha (Threat T-01-03).
ALLOWED_ORIGINS=http://localhost,http://localhost:5173

# JWT signing secret — generate with: python -c "import secrets; print(secrets.token_hex(32))"
# NEVER commit the real secret. Rotate if ever exposed.
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET_NEVER_COMMIT_THIS

# Admin superuser seeded on first startup (D-03).
# Used to bootstrap the first librarian account via /admin/users/{id}/promote.
ADMIN_EMAIL=admin@library.local
ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD
